<div style="display:flex;gap:7px;margin-top:16px">
<button class="btn pri" style="flex:1;justify-content:center" onclick="saveAll()">save</button>
<button class="btn" onclick="if(confirm('clear history + chat?')){localStorage.removeItem('${K}cw');localStorage.removeItem('${K}ai');msgs=[{r:'a',t:'cleared.'}];toast('cleared')}">clear data</button></div>
<div class="note">anime sources: ${ANI_SRC.map(s=>s.n).join(', ')}<br>movie sources: ${MOV_SRC.map(s=>s.n).join(', ')}<br>
proxies: ${PXY.map(p=>p.n).join(', ')}</div>
</div></div>`;
['sSh','sKy','sBg','sAu'].forEach(id=>$('#'+id).onclick=function(){this.classList.toggle('on')});
}
function saveAll(){
CFG.eng=$('#sE').value;CFG.pxy=$('#sP').value;CFG.src=$('#sS').value;
CFG.rawg=$('#sR').value.trim();CFG.cs=$('#sC').value.trim();
CFG.shield=$('#sSh').classList.contains('on')?1:0;CFG.keys=$('#sKy').classList.contains('on')?1:0;
CFG.bg=$('#sBg').classList.contains('on')?1:0;CFG.auto=$('#sAu').classList.contains('on')?1:0;
bgOn=CFG.bg;save();toast('saved');route();
}
function openCfg(){
fill('#cEng',SENG,CFG.eng);fill('#cPxy',PXY,CFG.pxy);fill('#cSrc',ANI_SRC.concat(MOV_SRC),CFG.src);
$('#cRawg').value=CFG.rawg;$('#cCs').value=CFG.cs;
['tSh','tKy','tBg','tAu'].forEach((id,i)=>$('#'+id).classList.toggle('on',!!CFG[['shield','keys','bg','auto'][i]]));
$('#cfg').classList.add('on');
}
const closeCfg=()=>$('#cfg').classList.remove('on');
function saveCfg(){
CFG.eng=$('#cEng').value;CFG.pxy=$('#cPxy').value;CFG.src=$('#cSrc').value;
CFG.rawg=$('#cRawg').value.trim();CFG.cs=$('#cCs').value.trim();
CFG.shield=$('#tSh').classList.contains('on')?1:0;CFG.keys=$('#tKy').classList.contains('on')?1:0;
CFG.bg=$('#tBg').classList.contains('on')?1:0;CFG.auto=$('#tAu').classList.contains('on')?1:0;
bgOn=CFG.bg;save();closeCfg();toast('saved');route();
}

/* ─── ROUTER ─── */
function nav(){
$('#nav').innerHTML=NAV.map(([sec,items])=>`<div class="slbl">${sec}</div>`
+items.map(([id,n])=>`<a class="nv" href="#/${id}">${n}${id==='search'?'<kbd>/</kbd>':''}</a>`).join('')).join('');
}
function route(){
const p=(location.hash.slice(1)||'/search').split('/').filter(Boolean);
const page=p[0]||'search';
$$('.nv').forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#/'+page));
$('#sb').classList.remove('open');V.scrollTop=0;
if(page!=='search'&&page!=='browser')V.classList.remove('flush');
switch(page){
case 'search': return p[1]?vSearch(p[1],p[2]||'web',decodeURIComponent(p.slice(3).join('/'))):vHome();
case 'anime': return p[1]?vAniDetail(p[1]):vAnime();
case 'movies': return p[1]?vMvDetail(p[1]):vMovies();
case 'movie': return vMvDetail(p[1]);
case 'watch': return vWatch(p[1],p[2]);
case 'watchmv': return vWatchMv(p[1],p[2],p[3]);
case 'games': return vGames();
case 'browser': return vBrowser(p[1]?decodeURIComponent(p[1]):null);
case 'apps': return vApps();
case 'ai': return vAI();
case 'settings': return vSettings();
default: return vHome();
}
}
/* topbar search */
let hT;
$('#q').addEventListener('input',e=>{
const v=e.target.value.trim();clearTimeout(hT);
if(v.length<2){$('#sg').classList.remove('on');return}
hT=setTimeout(async()=>{
const [a,m]=await Promise.allSettled([aniSearch(v),mvSearch(v)]);
let h='';
if(a.status==='fulfilled'&&a.value.length)h+=`<div class="sgh">anime</div>`+a.value.slice(0,3).map(x=>
`<div class="sgi" onclick="go('#/anime/${mkey(x)}')">${img(x.coverImage?.large)}
<div class="tx"><b>${esc(x.title.romaji||x.title.english)}</b><span>${esc(x.format||'')} ${x.seasonYear||''}</span></div></div>`).join('');
if(m.status==='fulfilled'&&m.value.length)h+=`<div class="sgh">movies</div>`+m.value.slice(0,3).map(x=>
`<div class="sgi" onclick="go('#/movie/${esc(x.imdb_id)}')">${img(x.poster)}
<div class="tx"><b>${esc(x.name)}</b><span>${esc(x.releaseInfo||'')}</span></div></div>`).join('');
$('#sg').innerHTML=h+`<div class="sgh">web</div><div class="sgi" onclick="go('#/search/${CFG.eng}/web/${encodeURIComponent(v)}')">
<div class="tx"><b>${esc(v)}</b><span>search via ${esc((SENG.find(s=>s.id===CFG.eng)||SENG[0]).n)}</span></div></div>`;
$('#sg').classList.add('on');
},280);
});
$('#q').addEventListener('keydown',e=>{if(e.key==='Enter'){const v=e.target.value.trim();
if(v){$('#sg').classList.remove('on');
if(/^https?:\/\//.test(v)||/^[\w-]+\.[a-z]{2,}(\/|$)/i.test(v))go('#/browser/'+encodeURIComponent(v));
else go('#/search/'+CFG.eng+'/web/'+encodeURIComponent(v))}}});
document.addEventListener('click',e=>{if(!e.target.closest('.sb'))$('#sg').classList.remove('on')});

/* boot */
nav();bgOn=CFG.bg;
addEventListener('hashchange',route);
route();
</script>
</body>
</html>
