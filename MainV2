{id:'mpmal',n:'megaplay-mal',t:'bk',b:(m,e,l)=>m.idMal?`https://megaplay.buzz/stream/mal/${m.idMal}/${e}/${l}`:0}
];
const MOV_SRC=[
{id:'videasy',n:'videasy',t:'self',b:x=>`https://player.videasy.ws/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?autoplay=${CFG.auto?1:0}`},
{id:'vaplayer',n:'vaplayer',t:'self',b:x=>`https://vaplayer.ru/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?autoplay=${CFG.auto?1:0}`},
{id:'embedmaster',n:'embedmaster',t:'bk',b:x=>`https://embedmaster.com/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}`},
{id:'codespecters',n:'nexstream',t:'bk',b:x=>x.tmdb?`https://api.codespecters.com/embed/${x.kind}/${x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?apikey=${encodeURIComponent(CFG.cs||'DEMO_36cd5611')}`:0}
];
const PLAYABLE=[
{n:'2048',u:'https://cdn.jsdelivr.net/gh/gabrielecirulli/2048@master/index.html',t:'puzzle'},
{n:'tetris',u:'https://cdn.jsdelivr.net/gh/jakesgordon/javascript-tetris@master/index.html',t:'classic'},
