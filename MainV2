<script>
/* config */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],V=$('#view');
const K='moplite.';
const ANI='https://graphql.anilist.co',JIK='https://api.jikan.moe/v4',CM='https://v3-cinemeta.strem.io';
const FTG='https://www.freetogame.com/api/games',RAWG='https://api.rawg.io/api',AI='https://text.pollinations.ai';
const WIKI='https://en.wikipedia.org/w/api.php';
const CFG=Object.assign({eng:'brave',pxy:'novene',src:'aniembed',rawg:'',cs:'DEMO_36cd5611',
shield:1,keys:1,bg:1,auto:1},JSON.parse(localStorage.getItem(K+'cfg')||'{}'));
const cache=new Map();
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const clean=s=>(s||'').replace(/<br\s*\/?>/gi,'\n').replace(/<[^>]+>/g,'').trim();
const b64=s=>btoa(unescape(encodeURIComponent(s)));
const unb64=s=>decodeURIComponent(escape(atob(s)));
const go=h=>{location.hash=h};
const save=()=>localStorage.setItem(K+'cfg',JSON.stringify(CFG));

/* sources */
const SENG=[
{id:'brave',n:'brave',u:'https://search.brave.com/search?q='},
{id:'google',n:'google',u:'https://www.google.com/search?q='},
