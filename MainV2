/* ─── HOME: proxy-style landing ─── */
function vHome(){
$('#ttl').innerHTML='<b>home</b>';
V.classList.add('flush');
V.innerHTML=`<div class="hero">
<div class="lg"><span class="d"></span>moplite<em>v4</em></div>
<div class="sub">type a url to proxy it, or a term to search · <a href="#/settings">config</a></div>
