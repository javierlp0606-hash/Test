<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#0b0b0c">
<title>Moplite</title>
<style>
:root{
--bg:#0b0b0c;--bg2:#101012;--sf:#141416;--sf2:#1a1a1d;--bd:#232326;--bd2:#333339;
--tx:#e6e6e8;--mu:#75757c;--mu2:#9a9aa2;--ac:#7ee787;--acd:#3fb950;
--mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
--sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
--sw:210px;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{background:var(--bg);color:var(--tx);font:13.5px/1.55 var(--sans);-webkit-font-smoothing:antialiased;overflow:hidden}
img{-webkit-user-drag:none;user-select:none;display:block}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
button:disabled{opacity:.32;cursor:not-allowed}
input,select,textarea{font:inherit;color:inherit;background:var(--sf);border:1px solid var(--bd);
border-radius:4px;padding:8px 11px;outline:0;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--bd2);background:var(--bg2)}
a{color:inherit;text-decoration:none}
::selection{background:var(--ac);color:#0b0b0c}
::-webkit-scrollbar{width:11px;height:11px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#2a2a2e;border:3px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:#3a3a40}

#bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.55}
#app{position:relative;z-index:1;display:flex;height:100%}

/* sidebar */
#sb{width:var(--sw);flex:0 0 var(--sw);background:var(--bg2);border-right:1px solid var(--bd);
display:flex;flex-direction:column;overflow-y:auto;z-index:100}
.brand{display:flex;align-items:baseline;gap:7px;padding:16px 15px 14px;
font-family:var(--mono);font-size:14px;font-weight:600;letter-spacing:-.2px}
.brand .d{width:7px;height:7px;background:var(--ac);border-radius:1px;flex:0 0 7px;align-self:center}
.brand em{font-style:normal;font-size:10px;color:var(--mu);letter-spacing:.4px}
.slbl{padding:13px 15px 5px;font-family:var(--mono);font-size:9.5px;font-weight:600;
letter-spacing:1.3px;text-transform:uppercase;color:#5c5c63}
.nv{display:flex;align-items:center;gap:9px;margin:1px 8px;padding:6px 9px;border-radius:3px;
color:var(--mu2);font-size:13px;transition:.1s;border-left:2px solid transparent}
.nv:hover{background:var(--sf);color:var(--tx)}
.nv.on{background:var(--sf);color:#fff;border-left-color:var(--ac);font-weight:500}
.nv .ic{width:14px;text-align:center;font-size:12px;opacity:.7;font-family:var(--mono)}
.nv kbd{margin-left:auto;font-family:var(--mono);font-size:9.5px;color:#5c5c63;
border:1px solid var(--bd);padding:0 4px;border-radius:2px}
.sfoot{margin-top:auto;padding:12px 15px;font-family:var(--mono);font-size:10.5px;
color:#5c5c63;line-height:2;border-top:1px solid var(--bd)}
.sfoot b{color:var(--mu);font-weight:400}

/* main */
#main{flex:1;display:flex;flex-direction:column;min-width:0}
#hd{display:flex;align-items:center;gap:12px;padding:0 16px;height:46px;flex:0 0 46px;
border-bottom:1px solid var(--bd);background:var(--bg2)}
#hd .ttl{font-family:var(--mono);font-size:12px;color:var(--mu2);letter-spacing:.2px}
#hd .ttl b{color:var(--tx);font-weight:600}
#hd .sp{flex:1}
#hd .sb{position:relative;width:100%;max-width:340px}
#hd .sb input{height:29px;padding:0 10px 0 30px;font-size:12.5px}
#hd .sb .si{position:absolute;left:10px;top:50%;transform:translateY(-50%);
color:var(--mu);font-size:12px;pointer-events:none;font-family:var(--mono)}
.hb{display:none;gap:8px;align-items:center;padding:7px 12px;border-bottom:1px solid var(--bd)}
#view{flex:1;overflow-y:auto;overflow-x:hidden;padding:20px 18px 70px}
#view.flush{padding:0}
.pill{padding:5px 10px;border-radius:3px;border:1px solid var(--bd);background:var(--sf);
font-family:var(--mono);font-size:11.5px;color:var(--mu2);transition:.1s;white-space:nowrap}
.pill:hover:not(:disabled){border-color:var(--bd2);color:var(--tx);background:var(--sf2)}
.pill.on{background:var(--ac);border-color:var(--ac);color:#0b0b0c;font-weight:600}
.pill.gh{background:transparent}
.btn{padding:8px 15px;border-radius:3px;background:var(--sf2);border:1px solid var(--bd2);
color:var(--tx);font-family:var(--mono);font-size:12px;font-weight:500;display:inline-flex;
gap:6px;align-items:center;transition:.1s}
.btn:hover{background:#232327;border-color:#3d3d44}
.btn.pri{background:var(--ac);border-color:var(--ac);color:#0b0b0c;font-weight:600}
.btn.pri:hover{background:#8ff09a;border-color:#8ff09a}

/* home */
.hero{min-height:calc(100vh - 46px);display:flex;flex-direction:column;
justify-content:center;padding:30px 22px 80px;max-width:660px;margin:0 auto}
.hero .lg{font-family:var(--mono);font-size:26px;font-weight:600;letter-spacing:-1px;
display:flex;align-items:baseline;gap:8px;margin-bottom:5px}
.hero .lg .d{width:9px;height:9px;background:var(--ac);border-radius:1px;align-self:center}
.hero .lg em{font-style:normal;font-size:11px;color:var(--mu);letter-spacing:.3px;font-weight:400}
.hero .sub{font-family:var(--mono);font-size:11.5px;color:var(--mu);margin-bottom:24px}
.hero .sub a{color:var(--mu2);border-bottom:1px dotted var(--bd2)}
.hero .sub a:hover{color:var(--ac)}
.hero .bx{position:relative}
.hero .bx input{height:44px;padding:0 96px 0 38px;font-size:14px;background:var(--sf);
font-family:var(--mono)}
.hero .bx .si{position:absolute;left:14px;top:50%;transform:translateY(-50%);
color:var(--mu);font-size:14px;pointer-events:none;font-family:var(--mono)}
.hero .bx .go{position:absolute;right:4px;top:4px;height:36px;padding:0 15px;border-radius:2px;
background:var(--sf2);border:1px solid var(--bd2);font-family:var(--mono);font-size:11.5px;color:var(--tx)}
.hero .bx .go:hover{background:#232327}
.hint{font-family:var(--mono);font-size:10.5px;color:#5c5c63;margin-top:8px;line-height:1.9}
.engs{display:flex;flex-wrap:wrap;gap:2px;margin-top:16px}
.engs .e{padding:4px 8px;border-radius:2px;font-family:var(--mono);font-size:11.5px;
color:var(--mu);border:1px solid transparent}
.engs .e:hover{color:var(--tx);background:var(--sf)}
.engs .e.on{color:var(--ac);border-color:var(--bd);background:var(--sf)}
.qk{margin-top:34px;border-top:1px solid var(--bd);padding-top:14px}
.qk .r{display:flex;align-items:baseline;gap:10px;padding:5px 0;font-size:12.5px}
.qk .r span{font-family:var(--mono);font-size:10.5px;color:#5c5c63;width:60px;flex:0 0 60px}
.qk .r a{color:var(--mu2)}
.qk .r a:hover{color:var(--ac)}
.qk .r .s{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:#5c5c63}
.hero .ft{margin-top:26px;font-family:var(--mono);font-size:10.5px;color:#5c5c63;
border-top:1px solid var(--bd);padding-top:12px;display:flex;gap:14px;flex-wrap:wrap}
.hero .ft b{color:var(--mu2);font-weight:400}

/* suggestions */
.sg{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--bg2);
border:1px solid var(--bd2);border-radius:3px;overflow:hidden;z-index:90;display:none;
max-height:60vh;overflow-y:auto}
.sg.on{display:block}
.sgh{padding:7px 11px 3px;font-family:var(--mono);font-size:9.5px;font-weight:600;
letter-spacing:1.2px;text-transform:uppercase;color:#5c5c63;background:var(--bg2)}
.sgi{display:flex;gap:9px;align-items:center;padding:6px 11px;cursor:pointer}
.sgi:hover{background:var(--sf)}
.sgi img{width:26px;height:38px;object-fit:cover;border-radius:2px;background:#000;flex:0 0 26px}
.sgi .tx{min-width:0;flex:1}
.sgi .tx b{font-size:12.5px;font-weight:500;display:block;white-space:nowrap;
overflow:hidden;text-overflow:ellipsis}
.sgi .tx span{font-family:var(--mono);font-size:10px;color:var(--mu)}
.sgi .kt{font-family:var(--mono);font-size:9px;color:#5c5c63;border:1px solid var(--bd);
padding:1px 4px;border-radius:2px;text-transform:uppercase}

/* results */
.sres{max-width:1000px;margin:0 auto}
.sbar{display:flex;gap:7px;margin-bottom:12px}
.sbar .w{position:relative;flex:1}
.sbar input{height:34px;padding-left:32px;font-family:var(--mono);font-size:13px}
.sbar .w .si{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--mu);
font-size:13px;font-family:var(--mono)}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--bd);margin-bottom:14px;overflow-x:auto}
.tab{padding:7px 13px;font-family:var(--mono);font-size:11.5px;color:var(--mu);
border-bottom:2px solid transparent;transition:.1s;white-space:nowrap}
.tab:hover{color:var(--tx)}
.tab.on{color:var(--ac);border-bottom-color:var(--ac)}
.res{display:flex;flex-direction:column}
.r{padding:11px 12px;border-radius:3px;display:block;transition:.1s}
.r:hover{background:var(--sf)}
.r .u{font-family:var(--mono);font-size:10.5px;color:#5c9c72;margin-bottom:2px}
.r h3{font-size:14.5px;font-weight:500;color:#a8c8ff;margin-bottom:2px;line-height:1.35}
.r:hover h3{text-decoration:underline}
.r p{font-size:12.5px;color:var(--mu2);line-height:1.6;display:-webkit-box;
-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.r .th{width:64px;height:64px;object-fit:cover;border-radius:2px;flex:0 0 64px}
.rrow{display:flex;gap:12px;align-items:flex-start}

/* grids */
.sec{margin-bottom:28px}
.sh{display:flex;align-items:baseline;gap:9px;margin-bottom:11px;
border-bottom:1px solid var(--bd);padding-bottom:7px}
.sh h2{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.3px;text-transform:uppercase;color:var(--mu2)}
.sh .c{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:#5c5c63}
.grid{display:grid;gap:10px}
.g-an{grid-template-columns:repeat(auto-fill,minmax(138px,1fr))}
.g-mv{grid-template-columns:repeat(auto-fill,minmax(146px,1fr))}
.g-gm{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
.card{position:relative;border-radius:3px;overflow:hidden;background:var(--sf);
border:1px solid var(--bd);cursor:pointer;transition:.12s;aspect-ratio:2/3}
.card:hover{border-color:var(--bd2)}
.card img{width:100%;height:100%;object-fit:cover}
.cov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.92) 0,transparent 50%);
display:flex;flex-direction:column;justify-content:flex-end;padding:8px}
.ct{font-size:12px;font-weight:500;line-height:1.32;display:-webkit-box;-webkit-line-clamp:2;
-webkit-box-orient:vertical;overflow:hidden}
.cm{font-family:var(--mono);font-size:9.5px;color:#9a9aa2;margin-top:2px;display:flex;gap:5px}
.bdg{position:absolute;top:5px;left:5px;padding:1px 5px;border-radius:2px;
background:rgba(0,0,0,.8);font-family:var(--mono);font-size:9.5px;color:#e3b341}
.fmt{position:absolute;top:5px;right:5px;padding:1px 5px;border-radius:2px;
background:rgba(0,0,0,.8);border:1px solid #3a3a40;font-family:var(--mono);font-size:9px;color:var(--mu2)}
.epn{position:absolute;bottom:5px;right:5px;padding:1px 5px;border-radius:2px;
background:rgba(0,0,0,.8);font-family:var(--mono);font-size:9.5px;color:var(--mu2)}
.mcard{position:relative;border-radius:3px;overflow:hidden;background:var(--sf);
border:1px solid var(--bd);cursor:pointer;transition:.12s}
.mcard:hover{border-color:var(--bd2)}
.mcard img{width:100%;aspect-ratio:2/3;object-fit:cover}
.gcard{border-radius:3px;overflow:hidden;background:var(--sf);border:1px solid var(--bd);
cursor:pointer;transition:.12s;display:flex;flex-direction:column}
.gcard:hover{border-color:var(--bd2)}
.gcard img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#000}
.gcard .gt{padding:8px 10px}
.gcard .gt b{font-size:12px;font-weight:500;display:block;line-height:1.35}
.gcard .gt span{font-family:var(--mono);font-size:10px;color:var(--mu)}

/* detail */
.dhero{position:relative;border-radius:3px;overflow:hidden;margin-bottom:18px;min-height:280px;
display:flex;align-items:flex-end;border:1px solid var(--bd)}
.dbg{position:absolute;inset:0;background-size:cover;background-position:center;filter:brightness(.38)}
.dfd{position:absolute;inset:0;background:linear-gradient(to top,var(--bg) 1%,transparent 80%)}
.din{position:relative;padding:18px;display:flex;gap:18px;align-items:flex-end;width:100%}
.dpo{width:140px;flex:0 0 140px;border-radius:2px;overflow:hidden;border:1px solid var(--bd2)}
.dpo img{width:100%}
.dtx{flex:1;min-width:0}
.dtx h1{font-size:clamp(20px,2.5vw,29px);font-weight:600;letter-spacing:-.7px;line-height:1.12;margin-bottom:7px}
.ml{display:flex;gap:7px;flex-wrap:wrap;align-items:center;color:var(--mu);font-size:11.5px;margin-bottom:9px}
.chips{display:flex;gap:4px;flex-wrap:wrap;margin:9px 0}
.chip{padding:2px 8px;border-radius:2px;background:var(--sf);border:1px solid var(--bd);
font-family:var(--mono);font-size:10.5px;color:var(--mu2)}
.desc{color:var(--mu2);line-height:1.7;font-size:13px;max-width:800px;white-space:pre-line;
user-select:text;margin-bottom:12px}
.stats{display:flex;gap:22px;flex-wrap:wrap;margin:12px 0 18px}
.st .k{font-family:var(--mono);font-size:9.5px;color:#5c5c63;text-transform:uppercase;letter-spacing:.9px}
.st .v{font-size:14px;font-weight:600;margin-top:1px}
.epg{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:6px}
.ep{padding:9px;border-radius:3px;background:var(--sf);border:1px solid var(--bd);text-align:left;transition:.1s}
.ep:hover{border-color:var(--ac)}
.ep b{font-family:var(--mono);font-size:11.5px}
.ep span{font-size:10px;color:var(--mu);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* player */
.pv{display:grid;grid-template-columns:1fr 274px;gap:16px;align-items:start}
@media(max-width:1040px){.pv{grid-template-columns:1fr}}
.pbox{position:relative;background:#000;border-radius:3px;overflow:hidden;border:1px solid var(--bd)}
.pfr{position:relative;width:100%;aspect-ratio:16/9}
.pfr iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.shield{position:absolute;inset:0;z-index:5;cursor:pointer}
.shield.pass{pointer-events:none}
.sbadge{position:absolute;right:6px;top:6px;z-index:6;padding:2px 6px;border-radius:2px;
background:rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.1);font-family:var(--mono);
font-size:9px;color:#7ee787;pointer-events:none;letter-spacing:.4px}
.srcbar{display:flex;gap:5px;flex-wrap:wrap;padding:8px;background:var(--bg2);border-top:1px solid var(--bd)}
.src{padding:4px 9px;border-radius:2px;background:var(--sf);border:1px solid var(--bd);
font-family:var(--mono);font-size:10.5px;color:var(--mu2);transition:.1s;display:flex;gap:5px;align-items:center}
.src:hover{border-color:var(--bd2);color:var(--tx)}
.src.on{background:var(--ac);border-color:var(--ac);color:#0b0b0c;font-weight:600}
.tag{font-size:8px;padding:0 4px;border-radius:2px;background:rgba(126,231,135,.15);
color:var(--ac);font-weight:600;letter-spacing:.3px}
.tag.bk{background:rgba(150,150,160,.14);color:var(--mu2)}
.src.on .tag{background:rgba(0,0,0,.22);color:#0b0b0c}
.side{background:var(--sf);border:1px solid var(--bd);border-radius:3px;overflow:hidden}
.side h3{padding:9px 11px;border-bottom:1px solid var(--bd);font-family:var(--mono);
font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--mu2)}
.sideb{max-height:480px;overflow-y:auto}
.srow{display:flex;gap:9px;padding:6px 10px;cursor:pointer;align-items:center;transition:.1s;
border-left:2px solid transparent}
.srow:hover{background:var(--sf2)}
.srow.on{background:var(--sf2);border-left-color:var(--ac)}
.srow img{width:66px;aspect-ratio:16/9;object-fit:cover;border-radius:2px;flex:0 0 66px;background:#000}
.srow .si{min-width:0}
.srow .si b{font-size:11.5px;display:block;font-weight:500}
.srow .si span{font-size:10px;color:var(--mu)}

/* browser */
.brw{display:flex;flex-direction:column;height:100%;gap:8px;padding:12px 14px 0}
.brbar{display:flex;gap:6px;align-items:center}
.brbar input{height:32px;padding-left:32px;font-family:var(--mono);font-size:12.5px}
.brbar .w{position:relative;flex:1}
.brbar .w .si{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--mu);
font-size:12px;font-family:var(--mono)}
.brwrap{position:relative;flex:1;min-height:0;background:#fff;border-radius:3px;
overflow:hidden;border:1px solid var(--bd)}
.brwrap iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* apps */
.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(124px,1fr));gap:8px}
.app{padding:13px 10px;border-radius:3px;background:var(--sf);border:1px solid var(--bd);
text-align:center;transition:.12s;cursor:pointer}
.app:hover{border-color:var(--bd2);background:var(--sf2)}
.app .em{width:30px;height:30px;border-radius:3px;display:grid;place-items:center;margin:0 auto 7px;
font-family:var(--mono);font-size:13px;background:var(--bg2);border:1px solid var(--bd);color:var(--mu2)}
.app b{font-size:12px;font-weight:500;display:block}
.app span{font-family:var(--mono);font-size:9.5px;color:#5c5c63;display:block;margin-top:1px}

/* ai */
.chat{display:flex;flex-direction:column;height:calc(100vh - 120px);gap:10px;max-width:820px;margin:0 auto}
.msgs{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:9px;padding:2px}
.msg{max-width:80%;padding:9px 13px;border-radius:4px;line-height:1.62;font-size:13px;
white-space:pre-wrap;word-wrap:break-word}
.msg.u{align-self:flex-end;background:var(--sf2);border:1px solid var(--bd2)}
.msg.a{align-self:flex-start;background:var(--sf);border:1px solid var(--bd)}
.cin{display:flex;gap:7px}
.cin textarea{flex:1;border-radius:3px;padding:10px 12px;resize:none;height:46px;font-size:13px}

/* misc */
.empty{text-align:center;padding:56px 20px;color:var(--mu)}
.empty .b{font-family:var(--mono);font-size:24px;margin-bottom:8px;opacity:.4}
.empty h3{font-size:13.5px;color:var(--tx);margin-bottom:3px;font-weight:500}
.empty p{font-family:var(--mono);font-size:11px}
.sk{background:var(--sf);border:1px solid var(--bd);border-radius:3px;
background-image:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.035) 50%,transparent 70%);
background-size:200% 100%;animation:sh 1.2s infinite}
@keyframes sh{to{background-position:-200% 0}}
#toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%) translateY(70px);
background:var(--sf2);border:1px solid var(--bd2);padding:8px 15px;border-radius:3px;z-index:300;
transition:.2s;font-family:var(--mono);font-size:11.5px}
#toast.on{transform:translateX(-50%) translateY(0)}
.mdl{position:fixed;inset:0;background:rgba(0,0,0,.66);z-index:200;display:none;
align-items:center;justify-content:center;padding:20px}
.mdl.on{display:flex}
.mdlc{background:var(--bg2);border:1px solid var(--bd2);border-radius:3px;padding:20px;width:100%;
max-width:460px;max-height:86vh;overflow-y:auto}
.mdlc h3{font-family:var(--mono);font-size:12px;font-weight:600;text-transform:uppercase;
letter-spacing:.8px;color:var(--mu2);margin-bottom:14px;border-bottom:1px solid var(--bd);padding-bottom:9px}
.fld{margin-bottom:12px}
.fld label{display:block;font-family:var(--mono);font-size:9.5px;color:#5c5c63;font-weight:600;
text-transform:uppercase;letter-spacing:.9px;margin-bottom:5px}
.fld select,.fld input{font-size:12.5px}
.sw{display:flex;justify-content:space-between;align-items:center;padding:8px 0;
