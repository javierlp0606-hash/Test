<script>
/* ═══ config ═══ */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],V=$('#view');
const K='moplite.';
const ANI='https://graphql.anilist.co',JIK='https://api.jikan.moe/v4',CM='https://v3-cinemeta.strem.io';
const FTG='https://www.freetogame.com/api/games',RAWG='https://api.rawg.io/api',AI='https://text.pollinations.ai';
const WIKI='https://en.wikipedia.org/w/api.php';
const CFG=Object.assign({eng:'brave',pxy:'novene',src:'aniembed',rawg:'',cs:'DEMO_36cd5611',
shield:1,keys:1,bg:1,auto:1},JSON.parse(localStorage.getItem(K+'cfg')||'{}'));
const cache=new Map();
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const clean=s=>(s||'').replace(/<br\s*\/?>/gi,'\n').replace(/<[^>]+>/g,'').trim();
const b64=s=>btoa(unescape(encodeURIComponent(s)));
const unb64=s=>decodeURIComponent(escape(atob(s)));
const go=h=>{location.hash=h};
const save=()=>localStorage.setItem(K+'cfg',JSON.stringify(CFG));

/* ═══ data sources ═══ */
const SENG=[
{id:'brave',n:'Brave',u:'https://search.brave.com/search?q='},
{id:'google',n:'Google',u:'https://www.google.com/search?q='},
{id:'bing',n:'Bing',u:'https://www.bing.com/search?q='},
{id:'ddg',n:'DuckDuckGo',u:'https://duckduckgo.com/?q='},
{id:'start',n:'Startpage',u:'https://www.startpage.com/sp/search?query='},
{id:'yt',n:'YouTube',u:'https://www.youtube.com/results?search_query='},
{id:'gh',n:'GitHub',u:'https://github.com/search?q='},
{id:'reddit',n:'Reddit',u:'https://www.reddit.com/search/?q='}
];
const PXY=[
{id:'novene',n:'Novene',u:'https://cdn.jsdelivr.net/gh/Mtreasur0133-bit/lotsohnovenecuzimnotabot-1@main/v0001/novene.svg?url='},
{id:'cherri',n:'Cherri',u:'https://cdn.jsdelivr.net/gh/NotAbdullahHD/cherri@main/index.svg?url='},
{id:'petezah',n:'PeteZah',u:'https://cdn.jsdelivr.net/gh/PeteZah-G/PeteZahStaticDone@main/new.svg?url='},
{id:'ddxpro',n:'DDX',u:'https://ddxpro.s3.us-east-1.amazonaws.com/index.html?url='},
{id:'uv',n:'Ultraviolet',u:'https://uv.mercurywork.shop/?url='}
];
const ANI_SRC=[
{id:'aniembed',n:'AniEmbed',t:'self',b:(m,e,l)=>m.id?`https://aniembed.se/e/${m.id}/${e}?lang=${l}&autoplay=${CFG.auto?1:0}`:0},
{id:'anilink',n:'AniLink',t:'self',b:(m,e,l)=>m.id?`https://anilink.cc/watch/${m.id}/${e}?variant=${l}&autoplay=${CFG.auto?1:0}`:0},
{id:'megaplay',n:'MegaPlay',t:'bk',b:(m,e,l)=>m.id?`https://megaplay.buzz/stream/ani/${m.id}/${e}/${l}`:0},
{id:'vidplus',n:'VidPlus',t:'bk',b:(m,e,l)=>m.id?`https://player.vidplus.to/embed/anime/${m.id}/${e}?dub=${l==='dub'}&autoplay=${CFG.auto}`:0},
{id:'tryembed',n:'TryEmbed',t:'bk',b:(m,e,l)=>m.id?`https://tryembed.us.cc/embed/anime/${m.id}/${e}/${l}`:0},
{id:'mpmal',n:'MegaPlay·MAL',t:'bk',b:(m,e,l)=>m.idMal?`https://megaplay.buzz/stream/mal/${m.idMal}/${e}/${l}`:0}
];
const MOV_SRC=[
{id:'videasy',n:'Videasy',t:'self',b:x=>`https://player.videasy.ws/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?autoplay=${CFG.auto?1:0}`},
{id:'vaplayer',n:'VAPlayer',t:'self',b:x=>`https://vaplayer.ru/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?autoplay=${CFG.auto?1:0}`},
{id:'embedmaster',n:'EmbedMaster',t:'bk',b:x=>`https://embedmaster.com/embed/${x.kind}/${x.imdb||x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}`},
{id:'codespecters',n:'NexStream',t:'bk',b:x=>x.tmdb?`https://api.codespecters.com/embed/${x.kind}/${x.tmdb}${x.kind==='tv'?`/${x.s}/${x.e}`:''}?apikey=${encodeURIComponent(CFG.cs||'DEMO_36cd5611')}`:0}
];
const PLAYABLE=[
{n:'2048',u:'https://cdn.jsdelivr.net/gh/gabrielecirulli/2048@master/index.html',t:'Puzzle'},
{n:'Tetris',u:'https://cdn.jsdelivr.net/gh/jakesgordon/javascript-tetris@master/index.html',t:'Classic'},
{n:'Hextris',u:'https://cdn.jsdelivr.net/gh/Hextris/hextris@gh-pages/index.html',t:'Arcade'},
{n:'Clumsy Bird',u:'https://cdn.jsdelivr.net/gh/ellisonleao/clumsy-bird@gh-pages/index.html',t:'Arcade'},
{n:'Pacman',u:'https://cdn.jsdelivr.net/gh/masonicGIT/pacman@master/index.html',t:'Classic'},
{n:'Astray',u:'https://cdn.jsdelivr.net/gh/wwwtyro/astray@gh-pages/index.html',t:'Maze'},
{n:'HexGL',u:'https://cdn.jsdelivr.net/gh/BKcore/HexGL@gh-pages/index.html',t:'Racing'},
{n:'Radius Raid',u:'https://cdn.jsdelivr.net/gh/viperbros/radius-raid@master/index.html',t:'Shooter'}
];
const APPS=[
{n:'YouTube',i:'▶',u:'https://youtube.com'},{n:'TikTok',i:'♪',u:'https://tiktok.com'},
{n:'Twitch',i:'◉',u:'https://twitch.tv'},{n:'Discord',i:'◈',u:'https://discord.com/app'},
{n:'Reddit',i:'☺',u:'https://reddit.com'},{n:'X',i:'✕',u:'https://x.com'},
{n:'Instagram',i:'◎',u:'https://instagram.com'},{n:'Spotify',i:'♫',u:'https://open.spotify.com'},
{n:'ChatGPT',i:'✦',u:'https://chatgpt.com'},{n:'Wikipedia',i:'W',u:'https://wikipedia.org'},
{n:'Google Drive',i:'▲',u:'https://drive.google.com'},{n:'GeForce NOW',i:'▷',u:'https://play.geforcenow.com'}
];
const NAV=[
['Search','',[['search','Search','⌕'],['browser','Browser','⊕'],['apps','Apps','⊞']]],
['Media','',[['anime','Anime','◈'],['movies','Movies','▶'],['games','Games','◉']]],
['Tools','',[['ai','Assistant','✦'],['settings','Settings','⚙']]]
];

/* ═══ helpers ═══ */
let tT;
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(tT);tT=setTimeout(()=>t.classList.remove('on'),2200)};
function jget(u,h){if(cache.has(u))return Promise.resolve(cache.get(u));
return fetch(u,{headers:h}).then(r=>{if(!r.ok)throw new Error(r.status);return r.json()}).then(d=>{cache.set(u,d);return d})}
const img=s=>s?`<img loading="lazy" decoding="async" src="${esc(s)}" alt="">`:'<img loading="lazy" alt="">';
const fill=(sel,arr,cur)=>$(sel).innerHTML=arr.map(o=>`<option value="${o.id}"${o.id===cur?' selected':''}>${esc(o.n)}</option>`).join('');

/* ═══ background ═══ */
const cv=$('#bg'),cx=cv.getContext('2d');let P=[],mx=-1e4,my=-1e4,bgOn=1;
function bgInit(){cv.width=innerWidth;cv.height=innerHeight;
const n=Math.min(70,Math.max(26,Math.floor(innerWidth*innerHeight/26000)));
P=Array.from({length:n},()=>({x:Math.random()*cv.width,y:Math.random()*cv.height,
vx:(Math.random()-.5)*.28,vy:(Math.random()-.5)*.28,r:Math.random()*1.5+.5}))}
function bgLoop(){
if(bgOn&&!document.hidden){
cx.clearRect(0,0,cv.width,cv.height);
for(const p of P){p.x+=p.vx;p.y+=p.vy;
if(p.x<0||p.x>cv.width)p.vx*=-1;if(p.y<0||p.y>cv.height)p.vy*=-1;
const dx=p.x-mx,dy=p.y-my,d=Math.hypot(dx,dy);
if(d<170&&d>1){p.x+=dx/d*.5;p.y+=dy/d*.5}}
for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){
const a=P[i],b=P[j],dx=a.x-b.x,dy=a.y-b.y,d2=dx*dx+dy*dy;
if(d2<17000){cx.globalAlpha=(1-d2/17000)*.3;cx.strokeStyle='#6366f1';cx.lineWidth=.55;
cx.beginPath();cx.moveTo(a.x,a.y);cx.lineTo(b.x,b.y);cx.stroke()}}
cx.globalAlpha=1;
for(const p of P){const d=Math.hypot(p.x-mx,p.y-my);
cx.fillStyle=d<150?'#22d3ee':'#4f46e5';cx.beginPath();cx.arc(p.x,p.y,d<150?p.r+1:p.r,0,7);cx.fill()}
}
requestAnimationFrame(bgLoop);
}
addEventListener('resize',bgInit);
addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY});
addEventListener('mouseleave',()=>{mx=my=-1e4});
bgInit();bgLoop();

/* ═══ anti-inspect ═══ */
function shield(host){const s=host.querySelector('.shield');if(!s)return;
if(!CFG.shield){s.style.display='none';const b=host.querySelector('.sbadge');if(b)b.style.display='none';return}
s.oncontextmenu=e=>{e.preventDefault();return false};
s.onmousedown=e=>{if(e.button===0)s.classList.add('pass')};
s.ontouchstart=()=>s.classList.add('pass');
s.onwheel=()=>{s.classList.add('pass');setTimeout(()=>s.classList.remove('pass'),80)}}
addEventListener('mouseup',()=>setTimeout(()=>{const s=$('.shield.pass');if(s)s.classList.remove('pass')},50));
addEventListener('touchend',()=>setTimeout(()=>{const s=$('.shield.pass');if(s)s.classList.remove('pass')},50));
document.addEventListener('contextmenu',e=>{
if(/INPUT|TEXTAREA/.test(e.target.tagName))return;
if(e.target.closest('.pbox')||e.target.closest('.brwrap'))return;e.preventDefault()});
document.addEventListener('keydown',e=>{
if(e.key==='/'&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){e.preventDefault();$('#q').focus();return}
if(e.key==='Escape'){closeCfg();$('#sg').classList.remove('on')}
if(!CFG.keys)return;
const k=e.key.toLowerCase();
if(e.key==='F12'){e.preventDefault();toast('F12 blocked');return}
if(e.ctrlKey&&e.shiftKey&&'ijc'.includes(k)){e.preventDefault();toast('Ctrl+Shift+'+e.key.toUpperCase()+' blocked');return}
if(e.ctrlKey&&k==='u'){e.preventDefault();toast('Ctrl+U blocked')}});
console.log('%cMoplite v4','font:800 22px Inter;background:linear-gradient(90deg,#6366f1,#22d3ee);-webkit-background-clip:text;color:transparent');
console.log('%cEmbed URLs are base64-encoded.','color:#6366f1');

/* ═══ player ═══ */
let cur={},curSrc=null;
const shell=()=>`<div class="pbox"><div class="pfr" id="pfr"></div><div class="shield"></div>
<div class="sbadge">🔒 SHIELDED</div></div><div class="srcbar" id="sbar"></div>`;
function setSrc(id){
const L=cur.kind==='anime'?ANI_SRC:MOV_SRC,s=L.find(x=>x.id===id)||L[0];
const url=cur.kind==='anime'?s.b(cur,cur.ep,'sub'):s.b(cur);
if(!url){toast(s.n+' unavailable');return}
curSrc=s.id;CFG.src=s.id;save();
$$('.src').forEach(b=>b.classList.toggle('on',b.dataset.s===s.id));
const e=b64(url),f=$('#pfr');f.dataset.enc=e;
f.innerHTML=`<iframe src="${url}" data-enc="${e}" allow="autoplay;fullscreen;encrypted-media;picture-in-picture" allowfullscreen referrerpolicy="origin"></iframe>`;
shield(document.querySelector('.pbox'))}
function srcBar(){
const L=cur.kind==='anime'?ANI_SRC:MOV_SRC;
$('#sbar').innerHTML=L.map(s=>`<button class="src ${s.id===curSrc?'on':''}" data-s="${s.id}" onclick="setSrc('${s.id}')">${esc(s.n)}<span class="tag ${s.t==='bk'?'bk':''}">${s.t==='self'?'SELF':'BACKUP'}</span></button>`).join('')
+`<button class="src" onclick="nxSrc()">↻ next</button><button class="src" onclick="cpEmb()">⧉ copy</button>
<button class="src" onclick="window.open(unb64(document.getElementById('pfr').dataset.enc),'_blank')">↗ tab</button>`}
function nxSrc(){const L=cur.kind==='anime'?ANI_SRC:MOV_SRC,i=L.findIndex(x=>x.id===curSrc);setSrc(L[(i+1)%L.length].id)}
const cpEmb=()=>navigator.clipboard.writeText(unb64($('#pfr').dataset.enc)).then(()=>toast('Embed copied'));

/* ═══ anime data ═══ */
const FRAG=`fragment M on Media{id idMal type format status episodes popularity averageScore
title{romaji english native} coverImage{extraLarge large} bannerImage description(asHtml:false) genres seasonYear
streamingEpisodes{title thumbnail} nextAiringEpisode{episode airingAt}
relations{edges{relationType node{id title{romaji english} coverImage{large} format type}}}}`;
async function gql(q,v){const r=await fetch(ANI,{method:'POST',headers:{'Content-Type':'application/json'},
body:JSON.stringify({query:q,variables:v})});
if(r.status===429){await new Promise(s=>setTimeout(s,1100));return gql(q,v)}
const j=await r.json();if(j.errors)throw new Error(j.errors[0].message);return j.data}
const mkey=m=>m.id?String(m.id):(m.idMal?'mal-'+m.idMal:m.imdb_id||m.id);
const aniSearch=async q=>(await gql(`query($q:String){Page(page:1,perPage:30){media(search:$q,type:ANIME,sort:SEARCH_MATCH,isAdult:false){...M}}} ${FRAG}`,{q})).Page.media;
async function aniBrowse(kind){
const now=new Date(),SE=['WINTER','SPRING','SUMMER','FALL'];
const M={trending:'TRENDING_DESC',popular:'POPULARITY_DESC',top:'SCORE_DESC'};
if(kind==='seasonal')return (await gql(`query($s:MediaSeason,$y:Int){Page(page:1,perPage:30){media(type:ANIME,season:$s,year:$y,sort:POPULARITY_DESC,isAdult:false){...M}}} ${FRAG}`,
{s:SE[Math.floor(now.getMonth()/3)],y:now.getFullYear()})).Page.media;
if(kind==='upcoming')return (await gql(`query{Page(page:1,perPage:30){media(type:ANIME,status:NOT_YET_RELEASED,sort:POPULARITY_DESC,isAdult:false){...M}}} ${FRAG}`)).Page.media;
return (await gql(`query{Page(page:1,perPage:30){media(type:ANIME,sort:${M[kind]},isAdult:false){...M}}} ${FRAG}`)).Page.media}
async function aniById(k){
if(/^\d+$/.test(k))return (await gql(`query($i:Int){Media(id:$i,type:ANIME){...M}} ${FRAG}`,{i:+k})).Media;
if(k.startsWith('mal-')){const a=(await jget(`${JIK}/anime/${k.slice(4)}/full`)).data;
return{id:null,idMal:a.mal_id,title:{romaji:a.title,english:a.title_english},
coverImage:{extraLarge:a.images?.jpg?.large_image_url},bannerImage:a.trailer?.images?.maximum_image_url||'',
description:a.synopsis,genres:(a.genres||[]).map(g=>g.name),averageScore:a.score?Math.round(a.score*10):null,
episodes:a.episodes,status:a.status,format:a.type,seasonYear:a.year,streamingEpisodes:[],relations:{edges:[]}}}
throw new Error('Not found')}
const epsOf=m=>{let n=m.episodes||(m.nextAiringEpisode?m.nextAiringEpisode.episode-1:0)||(m.streamingEpisodes||[]).length||12;
n=Math.max(1,Math.min(n,4000));const s=m.streamingEpisodes||[];
return Array.from({length:n},(_,i)=>({n:i+1,t:s[i]?.title,th:s[i]?.thumbnail}))};

/* ═══ movie data ═══ */
const mvCat=async k=>(await jget(`${CM}/catalog/movie/${k}.json`)).metas;
const mvSearch=async q=>(await jget(`${CM}/catalog/movie/top/search=${encodeURIComponent(q)}.json`)).metas;
const mvMeta=async id=>(await jget(`${CM}/meta/movie/${id}.json`)).meta;

/* ═══ games ═══ */
async function gmList(q){
if(CFG.rawg){try{const d=await jget(`${RAWG}/games?key=${CFG.rawg}&page_size=40${q?'&search='+encodeURIComponent(q):'&ordering=-added'}`);
return d.results.map(g=>({id:g.id,n:g.name,img:g.background_image,tag:(g.genres||[]).map(x=>x.name).slice(0,2).join(', '),url:'https://rawg.io/games/'+g.slug}))}catch(e){}}
const d=await jget(q?`${FTG}?category=${encodeURIComponent(q)}`:`${FTG}?sort-by=popularity`);
return d.map(g=>({id:g.id,n:g.title,img:g.thumbnail,tag:g.genre,url:g.game_url}))}

/* ═══ wikipedia ═══ */
const wikiSearch=async q=>(await jget(`${WIKI}?action=query&generator=search&gsrsearch=${encodeURIComponent(q)}&gsrlimit=16&prop=pageimages|extracts&exintro=1&explaintext=1&exsentences=2&piprop=thumbnail&pithumbsize=180&format=json&origin=*`)).query?.pages||{};
const wikiSuggest=async q=>(await jget(`${WIKI}?action=opensearch&search=${encodeURIComponent(q)}&limit=6&format=json&origin=*`))[1]||[];

/* ═══ cards ═══ */
const cAni=m=>`<div class="card" data-k="${esc(mkey(m))}">${m.averageScore?`<div class="bdg">★ ${(m.averageScore/10).toFixed(1)}</div>`:''}
${m.format?`<div class="fmt">${esc(m.format)}</div>`:''}${img(m.coverImage?.extraLarge||m.coverImage?.large)}
<div class="cov"><div class="ct">${esc(m.title.romaji||m.title.english||'?')}</div>
<div class="cm">${m.seasonYear?`<span>${m.seasonYear}</span>`:''}${m.status?`<span>${esc(String(m.status).replace(/_/g,' '))}</span>`:''}</div></div>
${m.episodes?`<div class="epn">${m.episodes} ep</div>`:''}</div>`;
const cMv=m=>`<div class="mcard" data-m="${esc(m.imdb_id||m.id)}">${img(m.poster)}
<div class="cov"><div class="ct">${esc(m.name)}</div><div class="cm">
${m.imdbRating?`<span style="color:var(--wn)">★ ${m.imdbRating}</span>`:''}<span>${esc(m.releaseInfo||'')}</span></div></div></div>`;
