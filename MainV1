msgs[msgs.length-1]={r:'a',t:(await r.text())||'(empty)'};
}catch(e){msgs[msgs.length-1]={r:'a',t:'⚠ '+e.message}}
localStorage.setItem(K+'ai',JSON.stringify(msgs.slice(-40)));vAI();$('#ms').scrollTop=1e6;
}

/* ═══ SETTINGS ═══ */
function vSettings(){
$('#ttl').innerHTML='Settings';V.classList.remove('flush');
V.innerHTML=`<div style="max-width:620px">
<div class="mdlc" style="max-width:100%;background:var(--sf)">
<h3>Defaults</h3>
<div class="fld"><label>Search engine</label><select id="sE">${SENG.map(e=>`<option value="${e.id}"${e.id===CFG.eng?' selected':''}>${esc(e.n)}</option>`).join('')}</select></div>
<div class="fld"><label>Proxy engine</label><select id="sP">${PXY.map(e=>`<option value="${e.id}"${e.id===CFG.pxy?' selected':''}>${esc(e.n)}</option>`).join('')}</select></div>
<div class="fld"><label>Player source</label><select id="sS">${ANI_SRC.concat(MOV_SRC).map(s=>`<option value="${s.id}"${s.id===CFG.src?' selected':''}>${esc(s.n)} · ${s.t==='self'?'self-hosted':'backup'}</option>`).join('')}</select></div>
<div class="fld"><label>RAWG key · games</label><input id="sR" value="${esc(CFG.rawg)}" placeholder="optional — rawg.io/apidocs"></div>
<div class="fld"><label>CodeSpecters key · movies</label><input id="sC" value="${esc(CFG.cs)}"></div>
<div class="sw"><span>Anti-inspect shield</span><div class="tg ${CFG.shield?'on':''}" id="sSh"></div></div>
<div class="sw"><span>Block keyboard shortcuts</span><div class="tg ${CFG.keys?'on':''}" id="sKy"></div></div>
<div class="sw"><span>Interactive background</span><div class="tg ${CFG.bg?'on':''}" id="sBg"></div></div>
<div class="sw"><span>Autoplay</span><div class="tg ${CFG.auto?'on':''}" id="sAu"></div></div>
<div style="display:flex;gap:9px;margin-top:20px">
<button class="btn" style="flex:1;justify-content:center" onclick="saveAll()">Save</button>
<button class="btn gh" onclick="if(confirm('Clear history and chat?')){localStorage.removeItem('${K}cw');localStorage.removeItem('${K}ai');msgs=[{r:'a',t:'Cleared.'}];toast('Cleared')}">Clear data</button></div>
<div class="note">Wired sources<br>Anime: ${ANI_SRC.map(s=>s.n).join(', ')}<br>Movies: ${MOV_SRC.map(s=>s.n).join(', ')}<br>
Proxies: ${PXY.map(p=>p.n).join(', ')}<br>Engines: ${SENG.map(s=>s.n).join(', ')}</div>
</div></div>`;
['sSh','sKy','sBg','sAu'].forEach((id,i)=>$('#'+id).onclick=function(){this.classList.toggle('on')});
}
function saveAll(){
CFG.eng=$('#sE').value;CFG.pxy=$('#sP').value;CFG.src=$('#sS').value;
CFG.rawg=$('#sR').value.trim();CFG.cs=$('#sC').value.trim();
CFG.shield=$('#sSh').classList.contains('on')?1:0;CFG.keys=$('#sKy').classList.contains('on')?1:0;
CFG.bg=$('#sBg').classList.contains('on')?1:0;CFG.auto=$('#sAu').classList.contains('on')?1:0;
bgOn=CFG.bg;save();toast('Settings saved');route();
}
function openCfg(){
fill('#cEng',SENG,CFG.eng);fill('#cPxy',PXY,CFG.pxy);fill('#cSrc',ANI_SRC.concat(MOV_SRC),CFG.src);
$('#cRawg').value=CFG.rawg;$('#cCs').value=CFG.cs;
['tSh','tKy','tBg','tAu'].forEach((id,i)=>$('#'+id).classList.toggle('on',!!CFG[['shield','keys','bg','auto'][i]]));
$('#cfg').classList.add('on');
}
const closeCfg=()=>$('#cfg').classList.remove('on');
function saveCfg(){
CFG.eng=$('#cEng').value;CFG.pxy=$('#cPxy').value;CFG.src=$('#cSrc').value;
CFG.rawg=$('#cRawg').value.trim();CFG.cs=$('#cCs').value.trim();
CFG.shield=$('#tSh').classList.contains('on')?1:0;CFG.keys=$('#tKy').classList.contains('on')?1:0;
CFG.bg=$('#tBg').classList.contains('on')?1:0;CFG.auto=$('#tAu').classList.contains('on')?1:0;
bgOn=CFG.bg;save();closeCfg();toast('Saved');route();
}

/* ═══ ROUTER ═══ */
const TITLES={search:'Search',anime:'Anime',movies:'Movies',games:'Games',browser:'Browser',apps:'Apps',ai:'Assistant',settings:'Settings'};
function nav(){
$('#nav').innerHTML=NAV.map(([sec,,items])=>`<div class="slbl">${sec}</div>`
+items.map(([id,n,i])=>`<a class="nv" href="#/${id}"><span class="ic">${i}</span>${n}${id==='search'?'<kbd>/</kbd>':''}</a>`).join('')).join('');
}
function route(){
const p=(location.hash.slice(1)||'/search').split('/').filter(Boolean);
const page=p[0]||'search';
$$('.nv').forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#/'+page));
$('#sb').classList.remove('open');V.scrollTop=0;
if(page!=='search'&&page!=='browser')V.classList.remove('flush');
switch(page){
case 'search': return p[1]?vSearch(p[1],p[2]||'web',decodeURIComponent(p.slice(3).join('/'))):vHome();
case 'anime': return p[1]?vAniDetail(p[1]):vAnime();
case 'movies': return p[1]?vMvDetail(p[1]):vMovies();
case 'movie': return vMvDetail(p[1]);
case 'watch': return vWatch(p[1],p[2]);
case 'watchmv': return vWatchMv(p[1],p[2],p[3]);
case 'games': return vGames();
case 'browser': return vBrowser(p[1]?decodeURIComponent(p[1]):null);
case 'apps': return vApps();
case 'ai': return vAI();
case 'settings': return vSettings();
default: return vHome();
}
}
/* top-bar search → routes into search page */
let hT;
$('#q').addEventListener('input',e=>{
const v=e.target.value.trim();clearTimeout(hT);
if(v.length<2){$('#sg').classList.remove('on');return}
hT=setTimeout(async()=>{
const [a,m]=await Promise.allSettled([aniSearch(v),mvSearch(v)]);
let h='';
if(a.status==='fulfilled'&&a.value.length)h+=`<div class="sgh">Anime</div>`+a.value.slice(0,3).map(x=>
`<div class="sgi" onclick="go('#/anime/${mkey(x)}')">${img(x.coverImage?.large)}
<div class="tx"><b>${esc(x.title.romaji||x.title.english)}</b><span>${esc(x.format||'')} ${x.seasonYear||''}</span></div></div>`).join('');
if(m.status==='fulfilled'&&m.value.length)h+=`<div class="sgh">Movies</div>`+m.value.slice(0,3).map(x=>
`<div class="sgi" onclick="go('#/movie/${esc(x.imdb_id)}')">${img(x.poster)}
<div class="tx"><b>${esc(x.name)}</b><span>${esc(x.releaseInfo||'')}</span></div></div>`).join('');
$('#sg').innerHTML=h+`<div class="sgh">Web</div><div class="sgi" onclick="go('#/search/${CFG.eng}/web/${encodeURIComponent(v)}')">
<div class="tx"><b>${esc(v)}</b><span>search the web with ${esc(SENG.find(s=>s.id===CFG.eng).n)}</span></div></div>`;
$('#sg').classList.add('on');
},320);
});
$('#q').addEventListener('keydown',e=>{if(e.key==='Enter'){const v=e.target.value.trim();
if(v){$('#sg').classList.remove('on');go('#/search/'+CFG.eng+'/web/'+encodeURIComponent(v))}}});
document.addEventListener('click',e=>{if(!e.target.closest('.sb'))$('#sg').classList.remove('on')});

/* ═══ boot ═══ */
nav();bgOn=CFG.bg;
addEventListener('hashchange',route);
route();
</script>
</body>
</html>
