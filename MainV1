<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#0a0a0f">
<title>Moplite v4</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
--bg:#0a0a0f;--sf:#111117;--sf2:#16161e;--bd:#1f1f2b;--bd2:#2a2a3a;
--tx:#e9e9f0;--mu:#82829a;--ac:#6366f1;--ac2:#22d3ee;--ok:#22c55e;--wn:#f59e0b;
--r:10px;--r2:14px;--sw:236px;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{background:var(--bg);color:var(--tx);font:14.5px/1.55 Inter,system-ui,sans-serif;
-webkit-font-smoothing:antialiased;overflow:hidden}
img{-webkit-user-drag:none;user-select:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
button:disabled{opacity:.35;cursor:not-allowed}
input,select,textarea{font:inherit;color:inherit;background:var(--sf);border:1px solid var(--bd);
border-radius:var(--r);padding:10px 13px;outline:0;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--ac)}
a{color:inherit;text-decoration:none}
::selection{background:var(--ac);color:#fff}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#242433;border-radius:10px;border:3px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:#33334a}

#bg{position:fixed;inset:0;z-index:0;pointer-events:none}
#app{position:relative;z-index:1;display:flex;height:100%}

/* ── SIDEBAR ── */
#sb{width:var(--sw);flex:0 0 var(--sw);background:#0c0c12;border-right:1px solid var(--bd);
display:flex;flex-direction:column;overflow-y:auto;z-index:100}
.brand{display:flex;align-items:center;gap:9px;padding:18px 18px 20px;font-weight:800;
font-size:16.5px;letter-spacing:-.4px}
.brand .mk{width:24px;height:24px;border-radius:7px;background:linear-gradient(135deg,#6366f1,#22d3ee);
display:grid;place-items:center;font-size:12px;color:#fff;font-weight:900;flex:0 0 24px}
.brand em{font-style:normal;font-size:10px;color:var(--mu);font-weight:600;
padding:2px 5px;border:1px solid var(--bd2);border-radius:5px;margin-left:1px}
.slbl{padding:12px 18px 6px;font-size:10.5px;font-weight:700;letter-spacing:1.1px;
text-transform:uppercase;color:#5a5a72}
.nv{display:flex;align-items:center;gap:11px;margin:1px 10px;padding:8px 11px;border-radius:8px;
color:#a2a2b8;font-weight:500;font-size:13.5px;transition:.14s}
.nv:hover{background:#16161f;color:var(--tx)}
.nv.on{background:#1a1a26;color:#fff;font-weight:600}
.nv .ic{width:17px;text-align:center;font-size:14px;opacity:.85;flex:0 0 17px}
.nv kbd{margin-left:auto;font-size:10px;color:#5a5a72;background:#16161f;
padding:1px 5px;border-radius:4px;font-family:inherit;font-weight:600}
.nv.on kbd{color:var(--mu)}
.sfoot{margin-top:auto;padding:14px 18px;font-size:11px;color:#5a5a72;line-height:1.9;
border-top:1px solid var(--bd)}
.sfoot b{color:var(--mu);font-weight:600}

/* ── MAIN ── */
#main{flex:1;display:flex;flex-direction:column;min-width:0}
#hd{display:flex;align-items:center;gap:12px;padding:0 18px;height:56px;flex:0 0 56px;
border-bottom:1px solid var(--bd);background:rgba(10,10,15,.86);backdrop-filter:blur(16px)}
#hd .ttl{font-weight:700;font-size:14.5px;letter-spacing:-.2px;white-space:nowrap}
#hd .ttl span{color:var(--mu);font-weight:500}
#hd .sp{flex:1}
#hd .sb{position:relative;width:100%;max-width:420px}
#hd .sb input{padding-left:36px;border-radius:20px;height:36px}
#hd .sb .si{position:absolute;left:13px;top:50%;transform:translateY(-50%);
color:var(--mu);pointer-events:none;font-size:13px}
.hb{display:none;gap:8px;align-items:center;padding:9px 14px;border-bottom:1px solid var(--bd)}
#view{flex:1;overflow-y:auto;overflow-x:hidden;padding:22px 20px 80px;position:relative}
#view.flush{padding:0}
.pill{padding:7px 13px;border-radius:8px;border:1px solid var(--bd);background:var(--sf);
font-size:12.5px;font-weight:600;transition:.14s;white-space:nowrap;color:#b4b4c8}
.pill:hover:not(:disabled){border-color:var(--bd2);background:var(--sf2);color:#fff}
.pill.on{background:var(--ac);border-color:var(--ac);color:#fff}
.pill.gh{background:transparent}
.btn{padding:10px 20px;border-radius:9px;background:var(--ac);color:#fff;font-weight:600;
font-size:13.5px;display:inline-flex;gap:7px;align-items:center;transition:.15s}
.btn:hover{background:#5457e0}
.btn.gh{background:var(--sf);border:1px solid var(--bd);color:var(--tx)}
.btn.gh:hover{background:var(--sf2);border-color:var(--bd2)}

/* ── SEARCH HOME ── */
.hero{min-height:calc(100vh - 56px);display:flex;flex-direction:column;align-items:center;
justify-content:center;padding:40px 22px 90px;gap:0}
.hero .lg{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.hero .lg .mk{width:46px;height:46px;border-radius:13px;background:linear-gradient(135deg,#6366f1,#22d3ee);
display:grid;place-items:center;font-size:23px;font-weight:900;color:#fff;
box-shadow:0 10px 34px rgba(99,102,241,.34)}
.hero h1{font-size:40px;font-weight:800;letter-spacing:-1.6px}
.hero h1 em{font-style:normal;color:var(--mu);font-weight:600;font-size:20px;
letter-spacing:-.4px;margin-left:6px}
.hero .tag{margin:6px 0 26px;color:var(--mu);font-size:13.5px;letter-spacing:.1px}
.hero .bx{width:100%;max-width:620px;position:relative}
.hero .bx input{height:54px;border-radius:27px;padding:0 122px 0 48px;font-size:15.5px;
background:var(--sf);border-color:var(--bd2);box-shadow:0 12px 40px rgba(0,0,0,.42)}
.hero .bx input:focus{border-color:var(--ac);box-shadow:0 12px 44px rgba(99,102,241,.22)}
.hero .bx .si{position:absolute;left:18px;top:50%;transform:translateY(-50%);
color:var(--mu);font-size:16px;pointer-events:none}
.hero .bx .go{position:absolute;right:6px;top:6px;height:42px;padding:0 20px;border-radius:22px;
background:var(--ac);color:#fff;font-weight:600;font-size:13.5px}
.hero .bx .go:hover{background:#5457e0}
.engs{display:flex;gap:7px;flex-wrap:wrap;justify-content:center;margin-top:16px;max-width:660px}
.engs .e{padding:6px 13px;border-radius:20px;border:1px solid var(--bd);background:transparent;
font-size:12.5px;font-weight:600;color:var(--mu);transition:.14s}
.engs .e:hover{border-color:var(--bd2);color:var(--tx)}
.engs .e.on{background:#1a1a26;border-color:#33334a;color:#fff}
.qk{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:9px;
width:100%;max-width:620px;margin-top:44px}
.qk a{display:flex;flex-direction:column;align-items:center;gap:7px;padding:14px 6px;
border-radius:var(--r2);border:1px solid var(--bd);background:var(--sf);transition:.16s}
.qk a:hover{border-color:var(--bd2);background:var(--sf2);transform:translateY(-2px)}
.qk .ic{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;
font-size:16px;background:#1a1a26;border:1px solid var(--bd2)}
.qk b{font-size:11.5px;font-weight:600;color:#b4b4c8}
.hero .ft{margin-top:34px;font-size:11.5px;color:#5a5a72;text-align:center;line-height:1.9}

/* ── SUGGESTIONS ── */
.sg{position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--sf);border:1px solid var(--bd2);
border-radius:var(--r2);overflow:hidden;z-index:90;display:none;max-height:62vh;overflow-y:auto;
box-shadow:0 20px 56px rgba(0,0,0,.62)}
.sg.on{display:block}
.sgh{padding:8px 14px 5px;font-size:10px;font-weight:700;letter-spacing:1px;
text-transform:uppercase;color:#5a5a72}
.sgi{display:flex;gap:10px;align-items:center;padding:7px 14px;cursor:pointer}
.sgi:hover,.sgi.sel{background:#1a1a26}
.sgi img{width:30px;height:44px;object-fit:cover;border-radius:4px;background:#000;flex:0 0 30px}
.sgi .tx{min-width:0;flex:1}
.sgi .tx b{font-size:13px;font-weight:600;display:block;white-space:nowrap;overflow:hidden;
text-overflow:ellipsis}
.sgi .tx span{font-size:11px;color:var(--mu)}
.sgi .kt{font-size:9.5px;font-weight:700;color:#5a5a72;padding:2px 6px;border:1px solid var(--bd2);
border-radius:4px;text-transform:uppercase;letter-spacing:.5px}

/* ── SEARCH RESULTS ── */
.sres{max-width:1080px;margin:0 auto}
.sbar{display:flex;gap:9px;align-items:center;margin-bottom:14px}
.sbar input{height:42px;border-radius:21px;padding-left:38px}
.sbar .w{position:relative;flex:1}
.sbar .w .si{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mu);font-size:14px}
.tabs{display:flex;gap:3px;border-bottom:1px solid var(--bd);margin-bottom:18px;overflow-x:auto}
.tab{padding:9px 15px;font-size:13px;font-weight:600;color:var(--mu);border-bottom:2px solid transparent;
transition:.14s;white-space:nowrap}
.tab:hover{color:var(--tx)}
.tab.on{color:#fff;border-bottom-color:var(--ac)}
.res{display:flex;flex-direction:column;gap:2px}
.r{padding:13px 14px;border-radius:var(--r);transition:.13s;display:block}
.r:hover{background:var(--sf)}
.r .u{font-size:11.5px;color:#5a9d8f;margin-bottom:3px;display:flex;align-items:center;gap:6px}
.r .u img{width:14px;height:14px;border-radius:3px}
.r h3{font-size:16px;font-weight:600;color:#9db4f0;margin-bottom:3px;line-height:1.35}
.r:hover h3{text-decoration:underline}
.r p{font-size:13px;color:#a0a0b6;line-height:1.62;display:-webkit-box;
-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.r .th{width:74px;height:74px;object-fit:cover;border-radius:8px;flex:0 0 74px}
.rrow{display:flex;gap:14px;align-items:flex-start}

/* ── GRIDS ── */
.sec{margin-bottom:34px}
.sh{display:flex;align-items:baseline;gap:11px;margin-bottom:14px}
.sh h2{font-size:16.5px;font-weight:700;letter-spacing:-.3px}
.sh .c{margin-left:auto;font-size:12px;color:var(--mu);font-weight:500}
.grid{display:grid;gap:13px}
.g-an{grid-template-columns:repeat(auto-fill,minmax(146px,1fr))}
.g-mv{grid-template-columns:repeat(auto-fill,minmax(152px,1fr))}
.g-gm{grid-template-columns:repeat(auto-fill,minmax(208px,1fr))}
.card{position:relative;border-radius:var(--r);overflow:hidden;background:var(--sf);
border:1px solid var(--bd);cursor:pointer;transition:.18s;aspect-ratio:2/3}
.card:hover{transform:translateY(-3px);border-color:var(--bd2);box-shadow:0 14px 32px rgba(0,0,0,.5)}
.card img{width:100%;height:100%;object-fit:cover;display:block;transition:.35s}
.card:hover img{transform:scale(1.05)}
.cov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.94) 0,transparent 52%);
display:flex;flex-direction:column;justify-content:flex-end;padding:9px}
.ct{font-size:12.5px;font-weight:600;line-height:1.32;display:-webkit-box;-webkit-line-clamp:2;
-webkit-box-orient:vertical;overflow:hidden}
.cm{font-size:10.5px;color:#9a9ab2;margin-top:3px;display:flex;gap:6px;flex-wrap:wrap}
.bdg{position:absolute;top:7px;left:7px;padding:2px 7px;border-radius:12px;background:rgba(0,0,0,.78);
font-size:10px;font-weight:700;color:var(--wn);backdrop-filter:blur(5px)}
.fmt{position:absolute;top:7px;right:7px;padding:2px 6px;border-radius:4px;
background:rgba(99,102,241,.9);font-size:9px;font-weight:700;letter-spacing:.3px}
.epn{position:absolute;bottom:7px;right:7px;padding:2px 6px;border-radius:4px;
background:rgba(0,0,0,.78);font-size:9.5px;font-weight:600}
.mcard{position:relative;border-radius:var(--r);overflow:hidden;background:var(--sf);
border:1px solid var(--bd);cursor:pointer;transition:.18s}
.mcard:hover{transform:translateY(-3px);border-color:var(--bd2);box-shadow:0 14px 32px rgba(0,0,0,.5)}
.mcard img{width:100%;aspect-ratio:2/3;object-fit:cover;display:block;transition:.35s}
.mcard:hover img{transform:scale(1.05)}
.gcard{border-radius:var(--r);overflow:hidden;background:var(--sf);border:1px solid var(--bd);
cursor:pointer;transition:.18s;display:flex;flex-direction:column}
.gcard:hover{transform:translateY(-3px);border-color:var(--bd2);box-shadow:0 14px 32px rgba(0,0,0,.5)}
.gcard img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#000}
.gcard .gt{padding:10px 12px}
.gcard .gt b{font-size:12.5px;display:block;line-height:1.35}
.gcard .gt span{font-size:10.5px;color:var(--mu)}
.gtag{display:inline-block;margin-top:5px;padding:2px 7px;border-radius:10px;
background:rgba(34,197,94,.14);color:#7dd8a0;font-size:9.5px;font-weight:700}

/* ── DETAIL ── */
.dhero{position:relative;border-radius:var(--r2);overflow:hidden;margin-bottom:22px;min-height:310px;
display:flex;align-items:flex-end;border:1px solid var(--bd)}
.dbg{position:absolute;inset:0;background-size:cover;background-position:center;filter:brightness(.4)}
.dfd{position:absolute;inset:0;background:linear-gradient(to top,var(--bg) 2%,transparent 78%)}
.din{position:relative;padding:24px;display:flex;gap:22px;align-items:flex-end;width:100%}
.dpo{width:158px;flex:0 0 158px;border-radius:9px;overflow:hidden;border:1px solid var(--bd2);
box-shadow:0 16px 40px rgba(0,0,0,.7)}
.dpo img{width:100%;display:block}
.dtx{flex:1;min-width:0}
.dtx h1{font-size:clamp(23px,2.9vw,34px);font-weight:800;letter-spacing:-1.1px;
line-height:1.08;margin-bottom:9px}
.ml{display:flex;gap:8px;flex-wrap:wrap;align-items:center;color:var(--mu);font-size:12.5px;margin-bottom:11px}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:11px 0}
.chip{padding:3px 10px;border-radius:14px;background:var(--sf);border:1px solid var(--bd);
font-size:11.5px;font-weight:500;color:#b4b4c8}
.desc{color:#b0b0c4;line-height:1.72;font-size:14px;max-width:860px;white-space:pre-line;
user-select:text;margin-bottom:14px}
.stats{display:flex;gap:24px;flex-wrap:wrap;margin:14px 0 22px}
.st .k{font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.9px;font-weight:700}
.st .v{font-size:17px;font-weight:700;margin-top:2px;letter-spacing:-.3px}
.epg{display:grid;grid-template-columns:repeat(auto-fill,minmax(116px,1fr));gap:8px}
.ep{padding:11px;border-radius:8px;background:var(--sf);border:1px solid var(--bd);text-align:left;transition:.14s}
.ep:hover{border-color:var(--ac);background:var(--sf2)}
.ep b{font-size:13.5px;font-weight:700}
.ep span{font-size:10.5px;color:var(--mu);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ── PLAYER ── */
.pv{display:grid;grid-template-columns:1fr 292px;gap:18px;align-items:start}
@media(max-width:1060px){.pv{grid-template-columns:1fr}}
.pbox{position:relative;background:#000;border-radius:var(--r);overflow:hidden;border:1px solid var(--bd)}
.pfr{position:relative;width:100%;aspect-ratio:16/9}
.pfr iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.shield{position:absolute;inset:0;z-index:5;cursor:pointer}
.shield.pass{pointer-events:none}
.sbadge{position:absolute;right:8px;top:8px;z-index:6;padding:3px 8px;border-radius:12px;
background:rgba(0,0,0,.66);border:1px solid rgba(255,255,255,.13);font-size:9.5px;font-weight:700;
color:#a5f3fc;backdrop-filter:blur(7px);pointer-events:none;letter-spacing:.4px}
.srcbar{display:flex;gap:6px;flex-wrap:wrap;padding:10px;background:#0e0e14;border-top:1px solid var(--bd)}
.src{padding:6px 11px;border-radius:7px;background:var(--sf);border:1px solid var(--bd);
font-size:11.5px;font-weight:600;transition:.14s;display:flex;gap:6px;align-items:center;color:#b4b4c8}
.src:hover{border-color:var(--bd2);color:#fff}
.src.on{background:var(--ac);border-color:var(--ac);color:#fff}
.tag{font-size:8.5px;padding:1px 5px;border-radius:3px;background:rgba(34,197,94,.2);
color:#86efac;font-weight:700;letter-spacing:.3px}
.tag.bk{background:rgba(148,163,184,.16);color:#a8b4c4}
.src.on .tag{background:rgba(0,0,0,.28);color:#fff}
.side{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);overflow:hidden}
.side h3{padding:11px 13px;border-bottom:1px solid var(--bd);font-size:12.5px;font-weight:700}
.sideb{max-height:500px;overflow-y:auto}
.srow{display:flex;gap:10px;padding:8px 11px;cursor:pointer;align-items:center;transition:.13s}
.srow:hover{background:var(--sf2)}
.srow.on{background:#1a1a26;border-left:2px solid var(--ac)}
.srow img{width:72px;aspect-ratio:16/9;object-fit:cover;border-radius:4px;flex:0 0 72px;background:#000}
.srow .si{min-width:0}
.srow .si b{font-size:11.5px;display:block}
.srow .si span{font-size:10px;color:var(--mu)}

/* ── BROWSER ── */
.brw{display:flex;flex-direction:column;height:100%;gap:10px;padding:14px 16px 0}
.brbar{display:flex;gap:8px;align-items:center}
.brbar input{height:38px;border-radius:19px;padding-left:36px}
.brbar .w{position:relative;flex:1}
.brbar .w .si{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--mu);font-size:13px}
.brwrap{position:relative;flex:1;min-height:0;background:#fff;border-radius:var(--r);
overflow:hidden;border:1px solid var(--bd)}
.brwrap iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* ── APPS ── */
.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:11px}
.app{padding:16px 12px;border-radius:var(--r2);background:var(--sf);border:1px solid var(--bd);
text-align:center;transition:.18s;cursor:pointer}
.app:hover{transform:translateY(-3px);border-color:var(--bd2);background:var(--sf2)}
.app .em{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;margin:0 auto 9px;
font-size:17px;background:#1a1a26;border:1px solid var(--bd2);font-weight:700}
.app b{font-size:12.5px;font-weight:600;display:block}
.app span{font-size:10px;color:var(--mu);display:block;margin-top:2px}

/* ── AI ── */
.chat{display:flex;flex-direction:column;height:calc(100vh - 130px);gap:12px;max-width:880px;margin:0 auto}
.msgs{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:11px;padding:4px}
.msg{max-width:78%;padding:11px 15px;border-radius:14px;line-height:1.62;font-size:14px;
white-space:pre-wrap;word-wrap:break-word}
.msg.u{align-self:flex-end;background:var(--ac);color:#fff;border-bottom-right-radius:4px}
.msg.a{align-self:flex-start;background:var(--sf);border:1px solid var(--bd);border-bottom-left-radius:4px}
.cin{display:flex;gap:9px}
.cin textarea{flex:1;border-radius:12px;padding:12px 14px;resize:none;height:50px}

/* ── MISC ── */
.empty{text-align:center;padding:64px 20px;color:var(--mu)}
.empty .b{font-size:36px;margin-bottom:10px;opacity:.55}
.empty h3{font-size:15px;color:var(--tx);margin-bottom:5px;font-weight:600}
.empty p{font-size:13px}
.sk{background:linear-gradient(100deg,#141420 30%,#1d1d2b 50%,#141420 70%);
background-size:200% 100%;animation:sh 1.3s infinite;border-radius:var(--r)}
@keyframes sh{to{background-position:-200% 0}}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(80px);
background:#16161e;border:1px solid var(--bd2);padding:10px 18px;border-radius:9px;z-index:300;
transition:.26s;font-size:12.5px;font-weight:600;box-shadow:0 14px 40px rgba(0,0,0,.65)}
#toast.on{transform:translateX(-50%) translateY(0)}
.mdl{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);z-index:200;
display:none;align-items:center;justify-content:center;padding:20px}
.mdl.on{display:flex}
.mdlc{background:#0e0e15;border:1px solid var(--bd2);border-radius:var(--r2);padding:24px;width:100%;
max-width:500px;max-height:86vh;overflow-y:auto}
